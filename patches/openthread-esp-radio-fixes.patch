-            RX_SIGNAL.wait().await;
+            // VENDORED PATCH: bounded wait instead of a bare signal wait.
+            //
+            // esp-radio's 15.4 driver has a known silent-RX-stall condition (see
+            // `ensure_receive_enabled` in esp-radio ieee802154/raw.rs: "avoids a
+            // problem with rx stopping unexpectedly"), and its self-heal only
+            // runs when the driver API is polled. A bare `RX_SIGNAL.wait()`
+            // never polls again, so a stall right after our own TX leaves the
+            // radio deaf until the next unrelated radio command — exactly when
+            // SRP / DNS / CASE responses arrive (observed as ~90% loss of
+            // prompt unicast responses while ambient multicasts get through).
+            // Re-polling every 10ms re-arms RX (`raw_received` →
+            // `ensure_receive_enabled`) within one MAC-retry window.
+            embassy_futures::select::select(
+                RX_SIGNAL.wait(),
+                embassy_time::Timer::after(embassy_time::Duration::from_millis(10)),
+            )
+            .await;
         };
 
