+        // stale queue memory (observed as rss 0 / -38 / -113 garbage). The
+        // ESP 802.15.4 hardware replaces the 2-byte FCS with RSSI + LQI, so
+        // RSSI is the second-to-last PSDU byte — the same slot esp-radio's
+        // own `received()` reads (`data[data[0] - 1]`). Garbage RSS fed
+        // OpenThread's neighbor link margins: a Router neighbor could sit at
+        // LinkQualityIn=0 (link cost ∞ → MeshForwarder NoRoute for
+        // everything) while its frames decoded perfectly — observed
+        // 2026-07-23 as the repeater's netdata-covered telemetry sink
+        // dropping 10,611:12 post-promotion.
+        let rssi = if psdu_len >= 2 {
+            Some(raw.data[1..][psdu_len - 2] as i8)
         } else {
