 /// `CHIP_DEVICE_CONFIG_FAILSAFE_EXPIRY_LENGTH_SEC` from the reference SDK.
 pub const DEFAULT_FAILSAFE_EXPIRY_SECS: u16 = 60;
 
+/// One-shot grace extension applied when the fail-safe times out while a
+/// commissioning is in flight (`AddNOC` processed under this fail-safe
+/// context). Out-of-spec bring-up aid — see `check_failsafe_timeout`.
+pub const FAILSAFE_GRACE_SECS: u16 = 180;
+
 pub struct FailSafe {
     state: State,
     secret_key: CanonPkcSecretKey,
@@ -135,27 +141,58 @@
         S: KvBlobStoreAccess,
         N: NetworksAccess,
     {
-        if let State::Armed(ctx) = &self.state {
+        let expired = if let State::Armed(ctx) = &mut self.state {
             let now = Instant::now();
             if now
                 >= ctx
                     .armed_at
                     .saturating_add(Duration::from_secs(ctx.timeout_secs as u64))
             {
-                // Timeout path: no caller exchange to preserve, so wipe
-                // every PASE session along with the fabric / networks
-                // rollback.
-                self.expire(
-                    fabrics,
-                    sessions,
-                    expire_sess_id,
-                    networks,
-                    kv,
-                    mdns_notif,
-                    notify_change,
-                )?;
-                return Ok(true);
+                // Bring-up aid (out-of-spec): if a fabric was added under this
+                // fail-safe (a real commissioning is in flight, not a pre-flow
+                // probe), grant a single grace extension instead of expiring.
+                // Google's controller has been observed reaching the device
+                // with CASE Sigma1 ~1s *after* its own 120s window in
+                // non-concurrent BLE→Thread commissioning; the grace keeps the
+                // staged fabric alive so the late CASE + CommissioningComplete
+                // can still land.
+                if ctx.flags.contains(NocFlags::ADD_NOC_RECVD)
+                    && !ctx.flags.contains(NocFlags::EXPIRY_GRACE_GRANTED)
+                {
+                    warn!(
+                        "Fail-Safe timeout for fabric {} with a commissioning in flight — extending once by {}s for a late commissioner",
+                        ctx.fab_idx, FAILSAFE_GRACE_SECS
+                    );
+
+                    ctx.flags |= NocFlags::EXPIRY_GRACE_GRANTED;
+                    ctx.armed_at = now;
+                    ctx.timeout_secs = FAILSAFE_GRACE_SECS;
+
+                    false
+                } else {
+                    true
+                }
+            } else {
+                false
             }
+        } else {
+            false
+        };
+
+        if expired {
+            // Timeout path: no caller exchange to preserve, so wipe
+            // every PASE session along with the fabric / networks
+            // rollback.
+            self.expire(
+                fabrics,
+                sessions,
+                expire_sess_id,
+                networks,
+                kv,
+                mdns_notif,
+                notify_change,
+            )?;
+            return Ok(true);
         }
 
         Ok(false)
