+    /// Request an immediate upgrade to the Router role (FTD only).
+    ///
+    /// Sends an Address Solicit to the leader right away instead of waiting for
+    /// the periodic REED self-evaluation with its randomized jitter. Valid only
+    /// while attached (typically as a child); returns `InvalidState` otherwise.
+    /// The role change (if the leader grants a router ID) is reported through
+    /// the normal state-change path.
+    #[cfg(feature = "ftd")]
+    pub fn become_router(&self) -> Result<(), OtError> {
+        let mut ot = self.activate();
+        let state = ot.state();
+
+        ot!(unsafe { otThreadBecomeRouter(state.ot.instance) })
+    }
+
+    /// Iterate the partition's Network Data: every on-mesh prefix and
+    /// external route, i.e. the set of destinations the border router(s)
+    /// have made routable from inside the mesh. Diagnostic aid.
+    ///
+    /// The closure receives `(is_external_route, prefix_octets, prefix_len)`.
+    pub fn netdata_dump<F: FnMut(bool, &[u8; 16], u8)>(&self, mut f: F) {
+        use sys::{
+            otBorderRouterConfig, otExternalRouteConfig, otNetDataGetNextOnMeshPrefix,
+            otNetDataGetNextRoute, otNetworkDataIterator,
+        };
+
+        let mut ot = self.activate();
+        let state = ot.state();
+        let instance = state.ot.instance;
+
+        let mut it: otNetworkDataIterator = 0;
+        let mut cfg = core::mem::MaybeUninit::<otBorderRouterConfig>::uninit();
+        while unsafe { otNetDataGetNextOnMeshPrefix(instance, &mut it, cfg.as_mut_ptr()) }
+            == otError_OT_ERROR_NONE
+        {
+            let cfg = unsafe { cfg.assume_init_ref() };
+            f(false, unsafe { &cfg.mPrefix.mPrefix.mFields.m8 }, cfg.mPrefix.mLength);
+        }
+
+        let mut it: otNetworkDataIterator = 0;
+        let mut cfg = core::mem::MaybeUninit::<otExternalRouteConfig>::uninit();
+        while unsafe { otNetDataGetNextRoute(instance, &mut it, cfg.as_mut_ptr()) }
+            == otError_OT_ERROR_NONE
+        {
+            let cfg = unsafe { cfg.assume_init_ref() };
+            f(true, unsafe { &cfg.mPrefix.mPrefix.mFields.m8 }, cfg.mPrefix.mLength);
+        }
+    }
+
+    /// Enable/disable eligibility for the Router/Leader roles (FTD only).
+    ///
+    /// While ineligible the device can only ever attach as a child: a failed
+    /// attach keeps searching instead of forming a new partition. Flip to
+    /// `true` after attaching to make the device promotable.
+    #[cfg(feature = "ftd")]
+    pub fn set_router_eligible(&self, eligible: bool) -> Result<(), OtError> {
+        let mut ot = self.activate();
+        let state = ot.state();
+
+        ot!(unsafe { otThreadSetRouterEligible(state.ot.instance, eligible) })
+    }
+
+    /// Return `true` if this device is the only router/leader in its partition
+    /// (FTD only). A Leader that stays singleton formed its own partition
+    /// instead of joining the intended network.
+    #[cfg(feature = "ftd")]
+    pub fn is_singleton(&self) -> bool {
+        let mut ot = self.activate();
+        let state = ot.state();
+
+        unsafe { otThreadIsSingleton(state.ot.instance) }
+    }
+
+    /// Return the number of children currently attached to this device
+    /// (FTD only; meaningful while in the Router/Leader role).
+    #[cfg(feature = "ftd")]
+    pub fn child_count(&self) -> u16 {
+        let mut ot = self.activate();
+        let state = ot.state();
+
+        let max = unsafe { otThreadGetMaxAllowedChildren(state.ot.instance) };
+        let mut count = 0;
+        for i in 0..max {
+            let mut info = core::mem::MaybeUninit::<otChildInfo>::uninit();
+            if unsafe { otThreadGetChildInfoByIndex(state.ot.instance, i, info.as_mut_ptr()) }
+                == otError_OT_ERROR_NONE
+            {
+                count += 1;
+            }
+        }
+        count
+    }
