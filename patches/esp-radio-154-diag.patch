+/// VENDORED PATCH: ISR-safe diagnostic counters for the Thread bring-up.
+///
+/// Incremented from the radio ISR with relaxed atomics (never logs, never
+/// blocks — logging from this ISR is what stalled the executor originally).
+/// A firmware task reads `snapshot()` periodically and prints the deltas.
+pub mod diag {
+    use core::sync::atomic::{AtomicU32, Ordering::Relaxed};
+
+    pub(crate) static SFD: AtomicU32 = AtomicU32::new(0);
+    pub(crate) static RX_QUEUED: AtomicU32 = AtomicU32::new(0);
+    pub(crate) static RX_QUEUE_FULL: AtomicU32 = AtomicU32::new(0);
+    pub(crate) static RX_ACK_IMM: AtomicU32 = AtomicU32::new(0);
+    pub(crate) static RX_ACK_ENH: AtomicU32 = AtomicU32::new(0);
+    pub(crate) static RX_NO_ACK: AtomicU32 = AtomicU32::new(0);
+    pub(crate) static ACK_TX_DONE: AtomicU32 = AtomicU32::new(0);
+    pub(crate) static TX_DONE: AtomicU32 = AtomicU32::new(0);
+    pub(crate) static ACK_RX_DONE: AtomicU32 = AtomicU32::new(0);
+    pub(crate) static ACK_TIMEOUT: AtomicU32 = AtomicU32::new(0);
+    pub(crate) static RX_REARM: AtomicU32 = AtomicU32::new(0);
+    pub(crate) static RX_DONE_EVT: AtomicU32 = AtomicU32::new(0);
+    pub(crate) static RX_ABORT: [AtomicU32; 32] = [const { AtomicU32::new(0) }; 32];
+    pub(crate) static TX_ABORT: [AtomicU32; 16] = [const { AtomicU32::new(0) }; 16];
+
+    #[inline(always)]
+    pub(crate) fn inc(c: &AtomicU32) {
+        c.fetch_add(1, Relaxed);
+    }
+
+    #[inline(always)]
+    pub(crate) fn inc_idx(arr: &[AtomicU32], idx: u32) {
+        let i = (idx as usize).min(arr.len() - 1);
+        arr[i].fetch_add(1, Relaxed);
+    }
+
+    /// Snapshot of all counters:
+    /// `(named, rx_abort_by_reason, tx_abort_by_reason)` where `named` is
+    /// `[sfd, rx_queued, rx_queue_full, rx_ack_imm, rx_ack_enh, rx_no_ack,
+    ///   ack_tx_done, tx_done, ack_rx_done, ack_timeout, rx_rearm, rx_done_evt]`.
+    pub fn snapshot() -> ([u32; 12], [u32; 32], [u32; 16]) {
+        let named = [
+            SFD.load(Relaxed),
+            RX_QUEUED.load(Relaxed),
+            RX_QUEUE_FULL.load(Relaxed),
+            RX_ACK_IMM.load(Relaxed),
+            RX_ACK_ENH.load(Relaxed),
+            RX_NO_ACK.load(Relaxed),
+            ACK_TX_DONE.load(Relaxed),
+            TX_DONE.load(Relaxed),
+            ACK_RX_DONE.load(Relaxed),
+            ACK_TIMEOUT.load(Relaxed),
+            RX_REARM.load(Relaxed),
+            RX_DONE_EVT.load(Relaxed),
+        ];
+        let mut rx = [0u32; 32];
+        for (i, c) in RX_ABORT.iter().enumerate() {
+            rx[i] = c.load(Relaxed);
+        }
+        let mut tx = [0u32; 16];
+        for (i, c) in TX_ABORT.iter().enumerate() {
+            tx[i] = c.load(Relaxed);
+        }
+        (named, rx, tx)
+    }
+}
